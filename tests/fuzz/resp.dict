# libFuzzer dictionary for fuzz_commands: RESP's tokens and every command
# and subcommand name, so mutations build commands the server knows and get
# past the command lookup sooner. Used with -dict=tests/fuzz/resp.dict.

# Protocol
crlf="\x0d\x0a"
array="*"
bulk="$"
null_len="-1"
array1="*1\x0d\x0a"
array2="*2\x0d\x0a"
array3="*3\x0d\x0a"
array4="*4\x0d\x0a"
bulk3="$3\x0d\x0a"
bulk4="$4\x0d\x0a"
bulk5="$5\x0d\x0a"
bulk0="$0\x0d\x0a"

# Commands
c1="PING"
c2="AUTH"
c3="HELLO"
c4="QUIT"
c5="MULTI"
c6="EXEC"
c7="DISCARD"
c8="COMMAND"
c9="CLIENT"
c10="CONFIG"
c11="INFO"
c12="SET"
c13="GET"
c14="SETEX"
c15="MGET"
c16="MSET"
c17="INCR"
c18="DECR"
c19="INCRBY"
c20="DECRBY"
c21="DEL"
c22="EXISTS"
c23="TYPE"
c24="EXPIRE"
c25="PEXPIREAT"
c26="TTL"
c27="LPUSH"
c28="RPUSH"
c29="LPOP"
c30="RPOP"
c31="LRANGE"
c32="LLEN"
c33="SADD"
c34="SREM"
c35="SMEMBERS"
c36="SISMEMBER"
c37="SCARD"
c38="HSET"
c39="HGET"
c40="HDEL"
c41="HGETALL"
c42="HLEN"
c43="BGREWRITEAOF"
c44="PEXPIRE"
c45="PERSIST"
c46="PTTL"
c47="DBSIZE"

# Subcommands and options
o1="ID"
o2="GETNAME"
o3="SETNAME"
o4="HELP"
o5="EX"
o6="PX"
o7="EXAT"
o8="PXAT"
o9="default"
o10="all"
o11="everything"
o12="server"
o13="clients"
o14="memory"
o15="stats"
o16="keyspace"
o17="persistence"

# Numbers at the edges of what string2ll reads
n1="9223372036854775807"
n2="-9223372036854775808"
n3="9223372036854775808"
n4="010"
n5="-0"
